{
  "info": {
    "name": "GLPI COLLECTION SQUAD 15 — Tarefa 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection do grupo com testes da tarefa 3. Configure base_url, client_id, client_secret, username e password localmente. POST /api/chat consulta os artigos com o token do usuário; não gera texto com IA."
  },
  "item": [
    {
      "name": "Create Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let body = {};",
              "try { body = pm.response.json(); } catch (error) { body = {}; }",
              "const ok = pm.response.code >= 200 && pm.response.code < 300 &&",
              "    typeof body.access_token === \"string\" && body.access_token.length > 0;",
              "pm.collectionVariables.set(\"access_token\", ok ? body.access_token : \"\");",
              "pm.collectionVariables.set(\"refresh_token\",",
              "    ok && typeof body.refresh_token === \"string\" ? body.refresh_token : \"\");",
              "pm.test(\"Resposta contém um access_token válido\", function () {",
              "    pm.expect(ok).to.equal(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"client_secret\": \"{{client_secret}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"scope\": \"api\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "token"
          ]
        }
      },
      "response": []
    },
    {
